+  /// Nearest axis entry in [0, 95, 135, 175, 215, 255], choosing lower ties.
+  private func cubeIndex(_ byte: Double) -> Int {
+    if byte <= 47.5 { return 0 }
+    if byte <= 115 { return 1 }
+    if byte <= 155 { return 2 }
+    if byte <= 195 { return 3 }
+    if byte <= 235 { return 4 }
+    return 5
+  }
+
+  private func cubeValue(_ index: Int) -> Double {
+    index == 0 ? 0 : Double(55 + 40 * index)
+  }
+
+  private func squared(_ value: Double) -> Double {
+    value * value
   }
 }
