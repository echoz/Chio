+    // Preserve the named-color mappings above. Other colors use the conventional
+    // extended palette (16...255); the terminal may customize those entries too.
+    // Compare squared distance in encoded RGB, after the existing gamut clamp.
+    let red = min(1, max(0, color.red)) * 255
+    let green = min(1, max(0, color.green)) * 255
+    let blue = min(1, max(0, color.blue)) * 255
+    let r = cubeIndex(red)
+    let g = cubeIndex(green)
+    let b = cubeIndex(blue)
+    let cubeCode = 16 + 36 * r + 6 * g + b
+    let cubeError =
+      squared(red - cubeValue(r)) + squared(green - cubeValue(g))
+      + squared(blue - cubeValue(b))
+
+    // The nearest gray is closest to the channel mean. Midpoint ties select the
+    // lower index; cube/gray ties select the cube, whose index is always lower.
+    let grayIndex = min(23, max(0, Int((((red + green + blue) / 3 - 8) / 10 - 0.5).rounded(.up))))
+    let gray = Double(8 + 10 * grayIndex)
+    let grayError = squared(red - gray) + squared(green - gray) + squared(blue - gray)
+    return grayError < cubeError ? 232 + grayIndex : cubeCode
