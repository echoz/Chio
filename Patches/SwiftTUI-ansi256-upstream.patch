diff --git a/Tests/SwiftTUITests/TerminalANSI256ColorTests.swift b/Tests/SwiftTUITests/TerminalANSI256ColorTests.swift
new file mode 100644
index 00000000..05f609c6
--- /dev/null
+++ b/Tests/SwiftTUITests/TerminalANSI256ColorTests.swift
@@ -0,0 +1,133 @@
+import SwiftTUIViews
+import Testing
+
+@testable import SwiftTUIRuntime
+
+@MainActor
+struct TerminalANSI256ColorTests {
+  @Test("ANSI256 preserves the documented named-color compatibility mappings")
+  func namedColors() {
+    let renderer = TerminalCellTextRenderer(capabilityProfile: .ansi256)
+    let aliases: [(Color, Int)] = [
+      (.black, 16), (.red, 203), (.green, 114), (.yellow, 179), (.blue, 111),
+      (.magenta, 176), (.cyan, 117), (.white, 255), (.gray, 145),
+    ]
+    for (color, code) in aliases {
+      #expect(renderer.ansi256Code(for: color) == code)
+    }
+  }
+
+  @Test("ANSI256 exactly represents conventional cube and grayscale entries except legacy white")
+  func paletteEntries() {
+    let renderer = TerminalCellTextRenderer(capabilityProfile: .ansi256)
+    for code in 16...255 {
+      let color = paletteColor(code)
+      // Pure white remains the existing .white compatibility mapping to 255.
+      #expect(renderer.ansi256Code(for: color) == (code == 231 ? 255 : code))
+    }
+  }
+
+  @Test("ANSI256 uses the actual cube thresholds and lower-index midpoint ties")
+  func thresholds() {
+    let renderer = TerminalCellTextRenderer(capabilityProfile: .ansi256)
+    for (index, threshold) in [47.5, 115, 155, 195, 235].enumerated() {
+      let lower = Color(red: threshold / 255, green: 1, blue: 0)
+      let upper = Color(red: (threshold + 0.01) / 255, green: 1, blue: 0)
+      #expect(renderer.ansi256Code(for: lower) == 16 + 36 * index + 30)
+      #expect(renderer.ansi256Code(for: upper) == 16 + 36 * (index + 1) + 30)
+    }
+    #expect(renderer.ansi256Code(for: Color(white: 13.0 / 255)) == 232)
+    #expect(renderer.ansi256Code(for: Color(white: 4.0 / 255)) == 16)
+    #expect(renderer.ansi256Code(for: Color(hexRGB: 0x211D2A)) == 235)
+  }
+
+  @Test("ANSI256 matches an exhaustive palette oracle across a bounded RGB grid")
+  func gridMatchesPalette() {
+    let renderer = TerminalCellTextRenderer(capabilityProfile: .ansi256)
+    let levels = Array(stride(from: 0, through: 255, by: 17))
+    for red in levels {
+      for green in levels {
+        for blue in levels {
+          let color = Color(
+            red: Double(red) / 255, green: Double(green) / 255,
+            blue: Double(blue) / 255)
+          let expected = color == .white ? 255 : nearestPaletteCode(color)
+          #expect(renderer.ansi256Code(for: color) == expected)
+        }
+      }
+    }
+  }
+
+  @Test("ANSI256 keeps out-of-gamut channels inside the extended palette")
+  func gamutClamp() {
+    let renderer = TerminalCellTextRenderer(capabilityProfile: .ansi256)
+    for color in [
+      Color(red: -1, green: 0.2, blue: 2),
+      Color(red: 2, green: -1, blue: 0.7),
+      Color(red: -1, green: -1, blue: -1),
+    ] {
+      #expect(renderer.ansi256Code(for: color) == nearestPaletteCode(color))
+    }
+  }
+
+  @Test("Foreground, background and underline share corrected ANSI256 conversion")
+  func emittedChannels() {
+    let color = Color(hexRGB: 0x211D2A)
+    let surface = styledSurface(color)
+    let indexed = TerminalSurfaceRenderer(capabilityProfile: .ansi256).render(surface)
+    #expect(indexed.contains("38;5;235"))
+    #expect(indexed.contains("48;5;235"))
+    #expect(indexed.contains("58;5;235"))
+    let trueColor = TerminalSurfaceRenderer(capabilityProfile: .trueColor).render(surface)
+    #expect(trueColor.contains("38;2;33;29;42"))
+    #expect(trueColor.contains("48;2;33;29;42"))
+    #expect(trueColor.contains("58;2;33;29;42"))
+    #expect(TerminalSurfaceRenderer(capabilityProfile: .previewUnicode).render(surface) == "x")
+  }
+
+  @Test("Terminal backdrop composition precedes ANSI256 quantization")
+  func transparentOverBackdrop() {
+    let renderer = TerminalSurfaceRenderer(
+      capabilityProfile: .ansi256, terminalBackgroundColor: Color(hexRGB: 0x211D2A))
+    let output = renderer.render(styledSurface(.white.withAlpha(0)))
+    #expect(output.contains("38;5;235"))
+    #expect(output.contains("48;5;235"))
+    #expect(output.contains("58;5;235"))
+  }
+
+  private func styledSurface(_ color: Color) -> RasterSurface {
+    RasterSurface(
+      size: .init(width: 1, height: 1), lines: ["x"],
+      styleRuns: [
+        .init(
+          x: 0, y: 0, length: 1,
+          style: .init(
+            foregroundColor: color, backgroundColor: color,
+            underlineStyle: .init(pattern: .solid, color: color)))
+      ])
+  }
+
+  private func paletteColor(_ code: Int) -> Color {
+    if code >= 232 { return Color(white: Double(8 + (code - 232) * 10) / 255) }
+    let levels = [0.0, 95, 135, 175, 215, 255]
+    let index = code - 16
+    return Color(
+      red: levels[index / 36] / 255, green: levels[(index / 6) % 6] / 255,
+      blue: levels[index % 6] / 255)
+  }
+
+  private func nearestPaletteCode(_ color: Color) -> Int {
+    func error(_ code: Int) -> Double {
+      let candidate = paletteColor(code)
+      let red = min(1, max(0, color.red)) * 255 - candidate.red * 255
+      let green = min(1, max(0, color.green)) * 255 - candidate.green * 255
+      let blue = min(1, max(0, color.blue)) * 255 - candidate.blue * 255
+      return red * red + green * green + blue * blue
+    }
+    return (16...255).min { lhs, rhs in
+      let left = error(lhs)
+      let right = error(rhs)
+      return left == right ? lhs < rhs : left < right
+    }!
+  }
+}
