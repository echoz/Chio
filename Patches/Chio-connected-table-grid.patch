+            "├───────┼────────┤",
+            "│ Test  │ Ready  │",
+            "╰───────┴────────╯",
+        ])
+        let rules = surface.cells.flatMap { $0 }.filter { "╭╮╰╯─│├┼┤┬┴".contains($0.character) }
+        try #require(!rules.isEmpty)
