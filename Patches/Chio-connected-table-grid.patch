+    @Test("Table rules form a continuous grid on Chio's surface over a black terminal",
+          arguments: [false, true])
+    func continuousGrid(light: Bool) throws {
+        let theme = light ? ChioTheme.light : .default
+        let surface = DefaultRenderer().render(
+            MarkdownView(MarkdownDocument("""
+            | Stage | Result |
+            | --- | --- |
+            | Build | Passed |
+            | Test | Ready |
